<?xml version="1.0" encoding="utf-8"?>
<!--
  应用图标前景 / 通知小图标共用的矢量：盾牌 + 表盘指针＝「守护 + 限时」。
  白色单色，既能当自适应图标前景，也能当状态栏小图标（系统会自行染色）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="#FFFFFF">

    <!-- 盾牌轮廓 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,26 L76,34 L76,54 C76,67 67,77.5 54,82 C41,77.5 32,67 32,54 L32,34 Z" />

    <!-- 表盘（挖空） -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#000000"
        android:strokeWidth="3.5"
        android:pathData="M54,42 m-13,0 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0" />

    <!-- 指针：12 点 + 4 点方向 -->
    <path
        android:strokeColor="#000000"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M54,42 L54,34" />
    <path
        android:strokeColor="#000000"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M54,42 L60,48" />
</vector>
